%% 09_family_systems.mmd — 가족관계 및 삼각관계 (보웬 가족체계이론 해석틀)
%% ⚠ 이 도식은 가능한 관계 구조를 비교하기 위한 해석틀이다. 조환의 실제 동기를 입증하지 않는다(CL-THY-05).
%% 실선: 사료에 나타난 관계(간접 확인) / 점선: 극중 설정·가설 / 굵은 선: 삼각관계에서 불안이 우회하는 경로(이론)
%% 변수: F1–F12, M2, M5, M9 (02_variables.yaml)
flowchart TB
  subgraph FAMILY["가족"]
    YUN(["윤씨 (피해자)"])
    JJH(["조재항 (남편·피고인)"])
    SIS(["윤씨 여동생 (극중)"])
    HWAN(["조환 (윤씨 친족·병환)<br/>지시문: 외숙부 = 극중 설정"])
    JJJ(["조재정 (조재항 아우·격쟁)"])
  end
  LGW(["이가원 (친족·무고 기획)<br/>친족 기준 인물: 사료 간 충돌(M2)"])

  JJH ---|"부부 (F1)"| YUN
  JJH -.-|"권분 갈등 (F2, 극중)"| YUN
  YUN -.-|"정서적 유대 (F3, 극중)"| HWAN
  YUN -.-|"마지막 행적 (F7, 극중)"| SIS
  JJJ ---|"형제·격쟁 (CL-SIM-04)"| JJH
  LGW ==>|"금품 요구 (M7, 간접 확인)"| JJH
  LGW ==>|"사주 (M9, 간접 확인)"| HWAN
  HWAN ==>|"고발 (M14)"| JJH

  %% 삼각관계 T1: 윤씨–조재항–조환
  T1{{"삼각관계 T1<br/>윤씨–조재항–조환<br/>부부 갈등의 불안이 조환과의 유대로 우회(F11, 이론)"}}
  YUN -.- T1
  JJH -.- T1
  HWAN -.- T1

  %% 삼각관계 T2: 조환–조재항–이가원 (사주의 핵심)
  T2{{"삼각관계 T2<br/>조환–조재항–이가원<br/>이가원이 조환의 정보원이 되어<br/>조재항에 대한 불신을 확대(F9·F12)"}}
  HWAN -.- T2
  JJH -.- T2
  LGW -.- T2

  %% 삼각관계 T3: 윤씨 여동생–조환–조재항
  T3{{"삼각관계 T3<br/>여동생–조환–조재항<br/>여동생의 '살아서 떠났다'는 정보가<br/>조환에게 전달되는가(F7·F4)"}}
  SIS -.- T3
  HWAN -.- T3
  JJH -.- T3

  %% 조환의 사주 수용 조건(03_constraints.py hwan_believes / hwan_accepts)
  COND["조환 수용 조건 (모형)<br/>믿음 = (병환 ∨ 고립) ∧ 언쟁 정보 ∧ (불신 ∨ 추가 '증거') ∧ (거절 이유 모름 ∨ 재구성)<br/>수용 = 믿음 ∧ (죄책감 ∨ 가족 의무) ∨ 금전 이해"]
  T2 --> COND
  COND --> HWAN

  classDef hist fill:#efe,stroke:#363;
  classDef film fill:#fee,stroke:#a44,stroke-dasharray:3;
  class JJH,YUN,JJJ,LGW hist;
  class SIS,HWAN film;
